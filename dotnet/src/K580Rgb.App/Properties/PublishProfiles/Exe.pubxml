<Project>
  <!-- dotnet publish src/K580Rgb.App -p:PublishProfile=Exe  ->  dist/K580Rgb.exe (one file, no .NET install needed) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- uncompressed: assemblies are mapped from the exe instead of unpacked into memory
         (118 MB on disk, but ~17 MB private memory instead of ~80 MB while running all day) -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- only the exe: no .pdb or package .xml docs next to it -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
